# AI Provider Configuration
# Choose one provider: gemini, openai, anthropic, grok, or openrouter
AI_PROVIDER=gemini

# Model Selection (optional - uses provider default if not set)
# Gemini: gemini-3.1-pro-preview, gemini-3-pro-preview, gemini-2.5-pro, gemini-2.5-flash
# OpenAI: gpt-5.3-codex, gpt-5.2, gpt-5.2-pro, gpt-5-mini
# Anthropic: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5
# Grok: grok-4, grok-4-1-fast-reasoning, grok-code-fast-1
# OpenRouter: openai/gpt-5.2, openai/gpt-5.1, anthropic/claude-opus-4-6
AI_MODEL=gemini-2.5-flash

# API Keys - Set the one for your chosen provider
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here  # Anthropic fallback alias
# GROK_API_KEY=your_grok_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# If AI_PROVIDER, AI_MODEL, or the resolved key is invalid/missing, review falls
# back to deterministic non-AI source review and reports findings from that path.

# Optional AI Settings
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=30000

# Optional CLI policy controls
# MP_SENTINEL_AI=1
# MP_SENTINEL_FORMAT=console
# MP_SENTINEL_CONCURRENCY=5

# Git Provider Configuration (optional)
# GIT_PROVIDER=github
# GITHUB_TOKEN=your_github_token
# GITLAB_TOKEN=your_gitlab_token
