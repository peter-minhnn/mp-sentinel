# AI Provider Configuration
# Choose one provider: gemini, openai, anthropic, grok, or openrouter
AI_PROVIDER=gemini

# Model Selection (optional - uses provider default if not set)
# Gemini: gemini-3.1-pro-preview, gemini-3-flash-preview, gemini-2.5-pro, gemini-2.5-flash
# OpenAI: gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-5.4-nano, gpt-5.2, gpt-5.2-pro, gpt-5-mini
# Anthropic: claude-opus-4-7, claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5
# Grok: grok-4.3, grok-4, grok-4-1-fast-reasoning, grok-code-fast-1
# OpenRouter: openai/gpt-5.5, anthropic/claude-opus-4-7, google/gemini-3.1-pro-preview, openai/gpt-5.2, google/gemini-2.5-flash, x-ai/grok-4.3

# Model tier (when AI_MODEL is not set): premium, balanced (default), or budget
# AI_MODEL_TIER=premium

# Model selection — overrides tier when set
AI_MODEL=gemini-2.5-flash

# API Keys - Set the one for your chosen provider
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here  # Anthropic fallback alias
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic  # Custom Anthropic-compatible endpoint (e.g., DeepSeek)
# GROK_API_KEY=your_grok_api_key_here
# XAI_API_KEY=your_xai_api_key_here  # Grok fallback alias
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter attribution (optional)
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_NAME=MyProject

# If AI_PROVIDER, AI_MODEL, or the resolved key is invalid/missing, the AI
# readiness probe disables AI for that run and falls back to deterministic
# non-AI source review. The fallback reports findings from the source path.

# Optional AI Settings
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=30000

# Optional CLI policy controls
# MP_SENTINEL_AI=1
# MP_SENTINEL_FORMAT=console
# MP_SENTINEL_CONCURRENCY=5

# Git Provider Configuration (optional)
# GIT_PROVIDER=github
# GITHUB_TOKEN=your_github_token
# GITLAB_TOKEN=your_gitlab_token
