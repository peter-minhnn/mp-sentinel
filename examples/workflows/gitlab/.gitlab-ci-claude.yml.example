image: node:24

cache:
  key:
    files:
      - package-lock.json
  paths:
    - node_modules/

stages:
  - audit

code_audit:
  stage: audit
  before_script:
    - npm ci
    - git fetch --unshallow 2>/dev/null || true
    - git fetch origin ${CI_MERGE_REQUEST_TARGET_BRANCH_NAME:-main}
  script:
    - npm run build
    - npx mp-sentinel indexing
    - npx mp-sentinel --target-branch origin/${CI_MERGE_REQUEST_TARGET_BRANCH_NAME:-main}
  rules:
    - if: $CI_PIPELINE_SOURCE == 'merge_request_event'
  variables:
    # Anthropic Configuration
    AI_PROVIDER: anthropic
    AI_MODEL: claude-sonnet-4-6  # Best for coding and agents
    # AI_MODEL: claude-opus-4-6  # Most capable, for complex tasks
    # AI_MODEL: claude-haiku-4-5  # Previous generation
    ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY

    # Optional: Fine-tune behavior
    AI_TEMPERATURE: "0.2"
    AI_MAX_TOKENS: "8192"

    # GitLab MR inline comments:
    #   - GITLAB_TOKEN (PAT/project token with `api` scope) is preferred and
    #     enables one-click "Suggest changes". The UI variable is injected
    #     automatically — do not hardcode it.
    #   - CI_JOB_TOKEN is the fallback when GITLAB_TOKEN is unset; it often
    #     lacks Discussions/Notes API permission, causing 401.
    #   - Caveat: a "Protected" GITLAB_TOKEN is NOT exposed to pipelines on
    #     regular (unprotected) MR branches, so it falls back to CI_JOB_TOKEN
    #     and commonly yields "401 Unauthorized". Leave GITLAB_TOKEN unprotected
    #     (masked) or restrict reviews to protected branches.
    # GITLAB_TOKEN: $GITLAB_TOKEN  # optional PAT; UI variable injects automatically

# Setup Instructions:
# 1. Get Anthropic API key: https://console.anthropic.com/
# 2. Add to GitLab CI/CD Variables: Settings → CI/CD → Variables → Add variable
#    Key: ANTHROPIC_API_KEY
#    Value: sk-ant-...
#    Flags: [x] Mask variable. Only [x] Protect variable if your MR pipelines
#           run on protected branches (protected vars are hidden from regular
#           MR branch pipelines — that hides ANTHROPIC_API_KEY and GITLAB_TOKEN).
# 3. Rename this file to: .gitlab-ci.yml
# 4. Commit and push
