image: node:24

cache:
  key:
    files:
      - package-lock.json
  paths:
    - node_modules/

stages:
  - audit

code_audit:
  stage: audit
  before_script:
    - npm ci
    - git fetch --unshallow 2>/dev/null || true
    - git fetch origin ${CI_MERGE_REQUEST_TARGET_BRANCH_NAME:-main}
  script:
    - npm run build
    - npx mp-sentinel indexing
    - npx mp-sentinel --target-branch origin/${CI_MERGE_REQUEST_TARGET_BRANCH_NAME:-main}
  rules:
    - if: $CI_PIPELINE_SOURCE == 'merge_request_event'
  variables:
    # OpenAI Configuration
    AI_PROVIDER: openai
    AI_MODEL_TIER: premium  # Best models; fall back to balanced or budget via env
    # AI_MODEL: gpt-5.2    # Explicit model overrides AI_MODEL_TIER
    OPENAI_API_KEY: $OPENAI_API_KEY

    # Optional: Fine-tune behavior
    AI_TEMPERATURE: "0.2"
    AI_MAX_TOKENS: "8192"

    # GitLab integration (CI_JOB_TOKEN is auto-available for MR comments)
    # GITLAB_TOKEN: $GITLAB_TOKEN  # Optional PAT

# Setup Instructions:
# 1. Get OpenAI API key: https://platform.openai.com/api-keys
# 2. Add to GitLab CI/CD Variables: Settings → CI/CD → Variables → Add variable
#    Key: OPENAI_API_KEY
#    Value: sk-...
#    Flags: [x] Protect variable, [x] Mask variable
# 3. Rename this file to: .gitlab-ci.yml
# 4. Commit and push
