{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-test",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["src/pure/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "dist-test"]
}
