{
  "name": "mp-sentinel",
  "version": "3.0.5",
  "description": "AI-powered Code Guardian with Multi-Provider Support - High-performance CLI for code auditing with Gemini, GPT-4, and Claude",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib.js",
      "types": "./dist/lib.d.ts"
    },
    "./cli": "./dist/index.js"
  },
  "bin": {
    "mp-sentinel": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "WHATS_NEW.md",
    "examples",
    "schemas",
    "scripts/release-check.mjs",
    "scripts/dogfood.mjs",
    "scripts/agent-skills-check.mjs",
    "scripts/agent-skills-refresh.mjs",
    "scripts/compliance-harness.mjs",
    "scripts/perf-budget.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "dogfood": "node scripts/dogfood.mjs",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "demo": "tsx examples/multi-provider-demo.ts",
    "demo:skills": "tsx examples/skills-demo.ts",
    "indexing": "tsx src/index.ts indexing",
    "review:staged": "tsx src/index.ts --staged",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "prepublishOnly": "npm run build",
    "agent:skills:check": "node scripts/agent-skills-check.mjs",
    "agent:skills:refresh": "node scripts/agent-skills-refresh.mjs",
    "compliance": "node scripts/compliance-harness.mjs",
    "compliance:dry": "node scripts/compliance-harness.mjs",
    "perf-budget": "node scripts/perf-budget.mjs",
    "release:check": "node scripts/release-check.mjs",
    "schema:gen": "tsx scripts/gen-config-schema.ts",
    "smoke:svelte": "node scripts/svelte-smoke.mjs",
    "test": "node --experimental-vm-modules --require ./jest.setup.cjs node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules --require ./jest.setup.cjs node_modules/jest/bin/jest.js --coverage",
    "format": "prettier --write --end-of-line auto \"src/**/*.ts\"",
    "format:check": "prettier --check --end-of-line auto \"src/**/*.ts\""
  },
  "keywords": [
    "code-review",
    "ai",
    "gemini",
    "gpt-4",
    "claude",
    "openai",
    "anthropic",
    "grok",
    "multi-provider",
    "clean-code",
    "audit",
    "cli",
    "linter",
    "conventional-commits",
    "local-review",
    "commit-patterns"
  ],
  "author": "Nguyen Nhat Minh",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "14.0.3",
    "dotenv": "^17.4.2",
    "fast-glob": "3.3.3",
    "ignore": "7.0.5",
    "prompts": "^2.4.2",
    "smol-toml": "^1.6.1",
    "tiktoken": "1.0.22",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "0.23.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/glob": "8.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^20.19.41",
    "@types/prompts": "^2.4.9",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "ts-node": "10.9.2",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "setupFiles": [
      "./jest.setup.cjs"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "bundler",
            "ignoreDeprecations": "6.0",
            "types": [
              "node"
            ]
          }
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter-minhnn/mp-sentinel.git"
  }
}
